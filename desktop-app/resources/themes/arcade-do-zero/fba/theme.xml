<theme>
  <formatVersion>4</formatVersion>
  <include>./../_inc/layout.xml</include>
  <view name="system, basic, detailed, video">
    <image name="bg" extra="true"><path>./bg.jpg</path></image>
    <image name="char" extra="true"><path>./char.png</path></image>
    <image name="title" extra="true"><path>./title.png</path></image>
  </view>
  <view name="basic, detailed, video">
    <image name="screen" extra="true"><path>./screen.jpg</path></image>
  </view>
  <view name="detailed, video">
    <image name="md_image"><default>./screen.jpg</default></image>
  </view>
  <view name="system">
    <image name="logo"><path>./wheel.png</path></image>
    <image name="screen" extra="true"><path>./showcase.jpg</path></image>
  </view>
</theme>
